# ---- required in production ----
NODE_ENV=production
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME   # add ?sslmode=require for most managed DBs
APP_SECRET=change-me-to-a-random-string-of-at-least-32-characters
PUBLIC_BASE_URL=https://your-domain.example              # used in e-mail links (no trailing slash)

# ---- optional ----
PORT=8787
HOST=0.0.0.0
ALLOW_SIGNUP=false          # true only while creating the first owner account
COOKIE_SECURE=true          # keep true behind HTTPS
TRUST_PROXY=true            # true behind Render/Fly/Railway load balancers
DB_POOL_MAX=10

# e-mail: "log" = never sends (records only). "smtp" = send via SMTP (Resend/Postmark/SES/SendGrid/Brevo…)
EMAIL_DRIVER=log
SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
EMAIL_FROM=Your Shop <no-reply@your-domain.example>

# background worker (reminders etc.) runs inside the web process every minute
RUN_WORKER=true
WORKER_INTERVAL_MS=60000

# optional bot protection on the public booking page (Cloudflare Turnstile). Leave empty to disable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# test only — never set in production
RATE_LIMIT_SCALE=1
